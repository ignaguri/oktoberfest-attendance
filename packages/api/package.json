{
  "name": "@prostcounter/api",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./share-cards": "./src/share-cards/public.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate-spec": "tsx src/scripts/generate-openapi.ts",
    "sync:achievements": "tsx src/scripts/sync-achievement-registry.ts",
    "seed:achievements": "tsx src/scripts/generate-achievements-seed.ts",
    "backfill:achievements": "tsx src/scripts/backfill-achievements.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@novu/api": "^3.19.1",
    "@prostcounter/db": "workspace:*",
    "@prostcounter/shared": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/functions": "^3.9.11",
    "hono": "^4.13.13",
    "i18next": "^26.4.4",
    "next": "16.4.0",
    "pino": "^10.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "7.3.5",
    "vitest": "^5.0.4"
  }
}
